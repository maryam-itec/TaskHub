<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main_calculator"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Calculator"
    android:background="@color/calc_background">

    <EditText
        android:id="@+id/inputValue"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:hint="0"
        android:textSize="40sp"
        android:textColor="@color/calc_text_dark_blue"
        android:paddingRight="25dp"
        android:layout_above="@+id/solutionValue"
        android:gravity="center_vertical|end"
        android:textAlignment="textEnd"
        android:background="@null"
        />

    <TextView
        android:id="@+id/solutionValue"
        android:layout_width="match_parent"
        android:layout_height="130dp"
        android:textSize="40sp"
        android:textColor="@color/light_grey"
        android:layout_centerHorizontal="true"
        android:paddingRight="30dp"
        android:layout_above="@+id/dividerLine"
        android:textAlignment="textEnd"
        android:gravity="top|end"
        android:layout_marginBottom="15dp"
        />

    <View
        android:id="@+id/dividerLine"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_above="@+id/linear_button"
        android:background="@color/line"
        android:layout_marginHorizontal="20dp"/>


    <LinearLayout
        android:id="@+id/linear_button"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_alignParentBottom="true"
        android:layout_marginTop="15dp"
        android:layout_marginBottom="15dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/allClearButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_clear_red"
                android:text="@string/ac"
                android:textSize="20sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/bracketButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="@string/bracket"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/percentButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="%"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/backButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_clear_red"
                android:text="C"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sevenButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="7"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/eightButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="8"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/nineButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="9"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/multiplyButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="x"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fourButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="4"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/fiveButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="5"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/sixButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="6"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/subtractButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="-"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/oneButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="1"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/twoButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="2"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/threeButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/calc_text_dark_blue"
                android:text="3"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/addButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="+"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/dotButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="."
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/zeroButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="0"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/divideButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="/"
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/equalButton"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_margin="10dp"
                android:backgroundTint="@color/calc_button_bg"
                android:textColor="@color/operator_blue"
                android:text="="
                android:textSize="22sp"
                app:cornerRadius="38dp"
                />

        </LinearLayout>

    </LinearLayout>
</RelativeLayout>

